# Frontend development server port used by Vite.
VITE_PORT=5173

# Frontend app display name. Safe example value only.
VITE_APP_TITLE=OfferPilot

# Backend API base URL used by axios request wrapper.
# Local development example:
VITE_API_BASE_URL=http://127.0.0.1:8080

# Optional switch for showing mock / debug information in future builds.
# Keep false in normal development unless the project explicitly uses it later.
VITE_ENABLE_DEVTOOLS=false
