# Docker Compose variables for local infrastructure startup.
# Copy this file to .env before running: docker compose up -d

# MySQL settings
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=offerpilot
MYSQL_USER=offerpilot
MYSQL_PASSWORD=offerpilot123

# Redis settings
REDIS_PORT=6379

# MinIO settings used by Milvus standalone
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Milvus settings
MILVUS_PORT=19530
MILVUS_HTTP_PORT=9091

