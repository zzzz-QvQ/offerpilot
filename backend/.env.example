# OfferPilot backend service port.
APP_PORT=8080

# JWT signing secret for authentication.
# Replace with a long random string in real environments.
APP_JWT_SECRET=replace_with_a_long_random_secret

# JWT expiration time in hours.
APP_JWT_EXPIRE_HOURS=72

# MySQL DSN.
# Example database name: offerpilot
MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/offerpilot?charset=utf8mb4&parseTime=True&loc=Local

# OpenAI-compatible chat completion endpoint base URL.
LLM_BASE_URL=https://api.openai.com/v1

# LLM API key. Leave empty in example file.
LLM_API_KEY=

# Default LLM model used by Interview / Review / Project modules.
LLM_MODEL=gpt-4o-mini

# OpenAI-compatible embedding endpoint base URL.
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Embedding API key. Leave empty in example file.
EMBEDDING_API_KEY=

# Default embedding model used for question knowledge indexing.
EMBEDDING_MODEL=text-embedding-3-small

# Milvus base URL.
MILVUS_BASE_URL=http://127.0.0.1:19530

# Milvus token if your instance requires authentication.
MILVUS_TOKEN=

# Milvus database name.
MILVUS_DATABASE=default

# Milvus collection used for question knowledge retrieval.
MILVUS_COLLECTION=question_knowledge

# Vector dimension of the embedding model above.
MILVUS_VECTOR_DIM=1536

# Whether to run question indexing during startup.
# Use true only for local indexing / initialization tasks.
ENABLE_QUESTION_INDEXING=false
